# kist-drl-g1-workstation — local credentials template.
#
# Loaded by src/run.py via python-dotenv from the repo root (CONV-001).
# Copy to `.env` and fill in; .env is .gitignored — never commit real keys.
#
# All variables below are read directly by the workstation Providers; no
# OM1-style indirection through a config JSON5 file.

# ----------------------------------------------------------------------
# STT — Google Cloud Speech-to-Text [TASK-42 / REQ-27]
# ----------------------------------------------------------------------
# Absolute path to a GCP service-account JSON with the
# "Cloud Speech Client" role. The Google SDK auto-discovers this env var,
# so stt_provider.py does not need an explicit credentials wiring.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-stt-service-account.json

# ----------------------------------------------------------------------
# TTS — Naver CLOVA Voice (Premium / TTS v1) [TASK-43 / REQ-29]
# ----------------------------------------------------------------------
# Obtain from NCP Console → AI·NAVER API → CLOVA Voice → 인증 정보.
# Read by tts_provider.py via TTSConfig.client_id_env / client_secret_env
# (overridable in code if your account uses different env var names).
NCP_CLOVA_CLIENT_ID=
NCP_CLOVA_CLIENT_SECRET=

# ----------------------------------------------------------------------
# Robot LAN (optional) — fallback when not set elsewhere.
# Set this to the G1 NX's IP on the demo LAN if any component falls back
# to env-based discovery. Most paths today rely on cyclonedds.xml's
# NetworkInterface autodetect + DDS domain match, so this is rarely needed.
# ----------------------------------------------------------------------
ROBOT_IP=
