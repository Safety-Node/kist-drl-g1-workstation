<CycloneDDS>
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface name="eno2" priority="default" multicast="false"/>
      </Interfaces>
      <!--
        Unicast-only peer discovery: explicitly list the NX as a peer.
        Matches the NX-side config (AllowMulticast=false + Peer address).
        DDS_PEER_IP defaults to NX IP; override via env var if needed.
      -->
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <Peers>
        <Peer address="${DDS_PEER_IP}"/>
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>200</MaxAutoParticipantIndex>
      <EnableTopicDiscoveryEndpoints>true</EnableTopicDiscoveryEndpoints>
    </Discovery>
  </Domain>
</CycloneDDS>
