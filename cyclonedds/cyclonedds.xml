<CycloneDDS>
  <Domain>
    <General>
      <Interfaces>
        <!--
          autodetermine: CycloneDDS picks the first non-loopback IPv4 interface
          with multicast support. Avoids hard-coding macOS ("en0") vs Linux
          ("eno1" / "enp3s0") naming; demo boxes can override via env:
              CYCLONEDDS_URI='<CycloneDDS><Domain><General><Interfaces>
                  <NetworkInterface name="ethX"/></Interfaces></General></Domain></CycloneDDS>'
          (overrides the file URI per CycloneDDS docs).
        -->
        <NetworkInterface name="eno2" priority="default" multicast="default" />
      </Interfaces>
    </General>
    <Discovery>
      <EnableTopicDiscoveryEndpoints>true</EnableTopicDiscoveryEndpoints>
    </Discovery>
  </Domain>
</CycloneDDS>
