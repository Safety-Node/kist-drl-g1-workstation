// sous_chef_g1.json5 — KIST G1 sous-chef demo ("주방보조 G1 로봇").
// OM1 mode_config shape; per-provider explicit configs in `providers:` (CONV-001).
// run.py loader: TODO (currently uses dataclass defaults).

{
  hertz: 10,
  name: "sous_chef_g1",
  system_prompt_base: "",                              // CONV-004: LLM Cortex deferred

  agent_inputs: [
    { type: "SoundSensor", config: { buffer_size: 5, min_confidence: 0.3, dedupe_window_s: 1.5 } },
  ],

  cortex_llm: null,                                    // CONV-004

  agent_actions: [
    { name: "move",  implementation: "MoveConnector",  config: {} },
    { name: "speak", implementation: "SpeakConnector", config: {} },
  ],

  backgrounds: [
    { type: "TaskSrvBg",     config: { tick_rate_hz: 10.0, swallow_tick_exceptions: true } },
    { type: "GUIBackground", config: {} },
  ],

  // KIST extension (CONV-001): providers are explicit, not lazy-init.
  providers: {
    unitree_g1: {
      ros_domain_id: 0,
      cyclonedds_uri: "file://cyclonedds/cyclonedds.xml",
      heartbeat_timeout_ms: 500,
      sensor_ttl_ms: 200,
      state_ttl_ms: 1000,
    },
    stt: {
      backend: "google_cloud",
      language_code: "ko-KR",
      sample_rate_hz: 16000,
      echo_cancel_tail_ms: 200,
    },
    tts: {
      backend: "naver_clova",
      language_code: "ko-KR",
      sample_rate_hz: 16000,
      voice: "nara",
      speed: 0,
    },
    vla: {
      backend: "groot_n17",
      model_server_url: "http://localhost:8000",
      // matches KIST fine-tune choice (NVIDIA example default is 8;
      // 16 per KIST measurement, source TBD — see CONV-006 REVISED).
      // Drives JointCmdChunk.steps[] length on /bridge/cmd/{arm,low}.
      action_horizon: 16,
      // PC publishes chunks at the VLA inference cadence; NX paces 100 Hz
      // (CONV-006 REVISED 2026-05-26). Assumed ~15 Hz — KIST L40
      // ~63.9 ms / chunk (~15.6 Hz, source TBD); RTX 4090 unmeasured.
      // Informational: setting this higher does NOT make the model emit
      // faster.
      chunk_emit_rate_hz: 15.0,
      gearsonic_enabled: true,
      gearsonic_device: "cuda:0",
      joint_delta_clip_rad: 0.25,
    },
    task_srv: {
      tick_rate_hz: 10.0,
      cancel_keywords: ["취소", "그만", "멈춰"],
    },
    // CONV-012 2026-05-26: locomotion split out of VLA into a PC-side
    // NavigationProvider. Emits Twist on /bridge/cmd/vel → NX
    // motor_controller LocoClient.Move(vx, vy, vyaw). control_rate_hz
    // TBD — 5/26 회의에서는 10-50 Hz 추정.
    navigation_provider: {
      control_rate_hz: 10.0,
      uwb_topic_in: "/uwb/raw",
    },
  },
}
